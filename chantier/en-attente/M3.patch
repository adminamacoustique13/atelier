+    second = lancer(agent, {**OUVRIER, "tentative": 2})
+    assert second.ouverte
+    assert avant(fabrique.journal, ("deconnexion", 0), ("connexion", 1))
+    assert comptes(fabrique) == (2, 2, 1)
