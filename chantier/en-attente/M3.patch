+    suite = lancer(agent, reprendre=premier.session, consigne=SUITE, dossier=tmp_path)
+    assert suite.fichiers == ["b.py"] and len(agent.suivis) == 1
+    assert (tmp_path / "b.py").read_text("utf-8") != avant_suite
