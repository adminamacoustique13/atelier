+        copie), elle rend "", qui veut dire « inconnue », jamais « inchangée ».
+        """
+        for _ in range(ESSAIS_EMPREINTE):
+            with suppress(RuntimeError, OSError, ValueError, subprocess.TimeoutExpired):
